# Bu dosyayı `.env` olarak kopyalayıp gerçek değerlerle doldurun.
# core/settings.py tüm bu değişkenleri os.environ üzerinden okur.

# --- Django ---
# Üretimde gizli tutun. Yeni bir anahtar üretmek için:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-secret-key
# 'true/1/yes/on' -> açık; diğer her değer kapalı. Üretimde kapalı bırakın.
DEBUG=True
# Virgülle ayrılmış host listesi (örn. localhost,127.0.0.1)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# Değişken adları resmi `postgres` Docker imajının beklediği isimlerle uyumludur.
POSTGRES_DB=workflow
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
